                                        }
                                    ]
                                },
                                {
                                    "type": "function",
                                    "value": "Exists",
                                    "description": "Test if the key specified by <var>value</var> is defined within the lookup table specified by <var>table</var>.<br/>\r\nReturn true (1) if it is defined, and false (0) otherwise.",
                                    "parameters": [
                                        {
                                            "name": "table",
                                            "type": "%Library.String",
                                            "default": "\"\"",
                                            "optional": 1
                                        },
                                        {
                                            "name": "value",
                                            "type": "%Library.String",
                                            "default": "\"\"",
                                            "optional": 1
                                        }
                                    ]
                                },
