                                            "optional": 0
                                        }
                                    ]
                                },
                                {
                                    "type": "function",
                                    "value": "DoesNotIntersectList",
                                    "description": "Tests if the given source list, <var>value</var>, does not contain any item that is contained in the target list, <var>items</var>.\r\nSee IntersectsList() for description.",
                                    "parameters": [
                                        {
                                            "name": "value",
                                            "type": "%Library.String",
                                            "optional": 0
                                        },
                                        {
                                            "name": "items",
                                            "type": "%Library.String",
                                            "optional": 0
                                        },
                                        {
                                            "name": "SourceListSeparator",
                                            "type": "%Library.String",
                                            "default": "\"><\"",
                                            "optional": 1
                                        },
                                        {
                                            "name": "TargetListSeparator",
                                            "type": "%Library.String",
                                            "default": "\"><\"",
                                            "optional": 1
                                        }
                                    ]
                                },
                                {
                                    "type": "function",
                                    "value": "DoesNotMatch",
                                    "description": "Tests if the given <var>value</var> matches the <var>pattern</var> given in the ? operator pattern syntax.",
                                    "parameters": [
                                        {
                                            "name": "value",
                                            "type": "%Library.String",
                                            "optional": 0
                                        },
                                        {
                                            "name": "pattern",
                                            "type": "%Library.String",
                                            "optional": 0
                                        }
                                    ]
                                },
