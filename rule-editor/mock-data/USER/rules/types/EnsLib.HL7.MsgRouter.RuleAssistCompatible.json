                                },
                                {
                                    "type": "function",
                                    "value": "If",
                                    "description": "If <var>value</var> is true, returns the value of <var>true</var>\r\notherwise returns the value of <var>false</var>.",
                                    "parameters": [
                                        {
                                            "name": "value",
                                            "type": "%Library.String",
                                            "default": "\"\"",
                                            "optional": 1
                                        },
                                        {
