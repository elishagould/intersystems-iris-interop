{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Preview: Mock API + Browser",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/rule-editor/preview.mjs",
      "cwd": "${workspaceFolder}/rule-editor",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Rule Editor V2: (http://127\\.0\\.0\\.1:[0-9]+/\\S*)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}/rule-editor",
        "killOnServerStop": true
      }
    },
    {
      "name": "Preview: Live API + Browser",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/rule-editor/preview.mjs",
      "args": ["--live"],
      "cwd": "${workspaceFolder}/rule-editor",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Rule Editor V2: (http://127\\.0\\.0\\.1:[0-9]+/\\S*)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}/rule-editor",
        "killOnServerStop": true
      }
    },
    {
      "name": "Browser: Existing IRIS Deployment",
      "type": "msedge",
      "request": "launch",
      "url": "${input:irisUrl}",
      "webRoot": "${workspaceFolder}/rule-editor"
    },
    {
      "name": "Build Static UI",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/rule-editor/build.mjs",
      "cwd": "${workspaceFolder}/rule-editor",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Package for IRIS",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/rule-editor/package.mjs",
      "cwd": "${workspaceFolder}/rule-editor",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests: All",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "--test-concurrency=1", "tests/*.test.mjs"],
      "cwd": "${workspaceFolder}/rule-editor",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests: Current File",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "${file}"],
      "cwd": "${workspaceFolder}/rule-editor",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach: Node Inspector",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    {
      "id": "irisUrl",
      "type": "promptString",
      "description": "Full URL of the installed IRIS Rule Editor",
      "default": "http://localhost:52773/iris-tools/rule-editor/index.html?$NAMESPACE=USER"
    }
  ]
}